{
  "buildCommand": "node scripts/build-web-vercel.cjs",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "pnpm install",
  "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_GIT_COMMIT_REF === 'main' ? 1 : 0)\"",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://e3-eos-api-staging-4m6nzwqkuq-ww.a.run.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}