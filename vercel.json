{
  "buildCommand": "node scripts/build-web-vercel.cjs",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "pnpm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "x-e3-release", "value": "1.0.1-scope-patch" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://e3-eos-api-staging-4m6nzwqkuq-ww.a.run.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}